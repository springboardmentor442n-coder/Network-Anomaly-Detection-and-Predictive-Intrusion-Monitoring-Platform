# NETSHIELD AI - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME="NETSHIELD AI"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=postgresql://netshield:netshield_password@postgres:5432/netshield_db
POSTGRES_USER=netshield
POSTGRES_PASSWORD=netshield_password
POSTGRES_DB=netshield_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="NETSHIELD AI"

# ML Configuration
MODEL_DIR=/app/models
DATA_DIR=/app/data
CHUNK_SIZE=1000
RANDOM_SEED=42
TEST_SIZE=0.2

# Alert Configuration
ALERT_ESCALATION_COUNT=3
ALERT_ESCALATION_WINDOW_MINUTES=10
ALERT_ESCALATION_BONUS=15

# Redis (optional)
REDIS_URL=redis://redis:6379/0
