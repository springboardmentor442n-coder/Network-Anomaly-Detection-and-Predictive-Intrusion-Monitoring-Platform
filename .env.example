# ---------------------------------------------------------------------------
# NetShield AI — environment variables (copy to .env)
#
#   copy .env.example .env        (Windows PowerShell)
#   cp   .env.example .env        (macOS / Linux)
#
# Every value below is OPTIONAL. The defaults are what the project uses when
# no .env file is present, and they work for a normal local setup.
# Never commit the real .env file — it is git-ignored.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Frontend (Next.js) — must be prefixed with NEXT_PUBLIC_ to reach the browser
# ---------------------------------------------------------------------------

# Base URL the browser uses to call the FastAPI backend.
# Default: /pyapi  -> proxied by next.config.mjs to BACKEND_URL, so the browser
#                     makes same-origin requests and CORS is never involved.
# Set this only if you want the browser to hit the backend directly, e.g.
#   NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# (in that case the backend's CORS_ORIGINS must include your frontend origin)
NEXT_PUBLIC_API_BASE=/pyapi

# Where the Next.js dev/prod server forwards /pyapi/* requests.
# Default: http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Backend (FastAPI) — read at import time by backend/app/config.py
# ---------------------------------------------------------------------------

# Where uploaded datasets, trained models, evaluation records, detection runs
# and the alerts SQLite database are written.
# Default: backend/storage   (git-ignored)
# NETSHIELD_STORAGE_DIR=

# Read-only folder scanned for ready-made CSV files (the "project files" list
# on the Dataset Analysis page). Drop UNSW_NB15_training-set.csv and
# UNSW_NB15_testing-set.csv here.
# Default: <project root>/data
# NETSHIELD_DATA_DIR=
