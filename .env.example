# NetShield AI - environment template
#
# Copy to .env and fill in real values. NEVER commit a filled-in .env:
# .gitignore already excludes it.
#
# Every value below is a placeholder. The application starts without any of
# them, but optional integrations report themselves as "not configured" until
# the relevant variables are set.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NETSHIELD_APP_NAME=NetShield AI
# development | production
NETSHIELD_ENV=development
NETSHIELD_DEBUG=false

# Dev server bind settings used by `python -m backend`.
# If NETSHIELD_PORT is already in use, startup aborts with an explanation
# rather than letting another process keep serving the port.
NETSHIELD_HOST=127.0.0.1
NETSHIELD_PORT=8000
NETSHIELD_RELOAD=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite (default, local development):
#   sqlite:///./netshield.db
# PostgreSQL (recommended for production):
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/netshield
NETSHIELD_DATABASE_URL=sqlite:///./netshield.db

# Used only by docker-compose to initialise the postgres service.
POSTGRES_DB=netshield
POSTGRES_USER=netshield
POSTGRES_PASSWORD=replace-with-a-strong-password

# ---------------------------------------------------------------------------
# Security  (REQUIRED for anything other than local development)
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NETSHIELD_JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters
NETSHIELD_JWT_EXPIRY_MINUTES=120
NETSHIELD_PASSWORD_MIN_LENGTH=8

# Comma-separated origins. Do not leave as * in production.
NETSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
NETSHIELD_RATE_LIMIT_ENABLED=true
NETSHIELD_RATE_LIMIT_LOGIN=10/minute
NETSHIELD_RATE_LIMIT_REGISTER=5/minute
NETSHIELD_RATE_LIMIT_DEFAULT=300/minute

# ---------------------------------------------------------------------------
# Data and models
# ---------------------------------------------------------------------------
# Directory that contains CICIDS2017_improved/ (see data/README.md)
NETSHIELD_DATA_ROOT=.
NETSHIELD_MODEL_ROOT=./models
NETSHIELD_ANALYTICS_SAMPLE_LIMIT=250000
NETSHIELD_ANALYTICS_CHUNK_SIZE=50000
NETSHIELD_ANALYTICS_CACHE_SECONDS=300

# ---------------------------------------------------------------------------
# Risk scoring  (see docs/technical-pipeline.md)
# ---------------------------------------------------------------------------
NETSHIELD_RISK_ANOMALY_POINTS=35
NETSHIELD_RISK_ATTACK_WEIGHT=45
NETSHIELD_RISK_CONFIDENCE_WEIGHT=15
NETSHIELD_RISK_UNKNOWN_TYPE_POINTS=10
NETSHIELD_SEVERITY_CRITICAL=85
NETSHIELD_SEVERITY_HIGH=65
NETSHIELD_SEVERITY_MEDIUM=35

# ---------------------------------------------------------------------------
# Alerting
# ---------------------------------------------------------------------------
# Minimum risk score that creates an alert.
NETSHIELD_ALERT_MIN_RISK_SCORE=65
# Severities that dispatch outbound notifications (comma-separated).
NETSHIELD_NOTIFY_SEVERITIES=CRITICAL

# ---------------------------------------------------------------------------
# Notifications - email (optional)
# ---------------------------------------------------------------------------
NETSHIELD_SMTP_HOST=
NETSHIELD_SMTP_PORT=587
NETSHIELD_SMTP_USERNAME=
NETSHIELD_SMTP_PASSWORD=
NETSHIELD_SMTP_USE_TLS=true
NETSHIELD_ALERT_EMAIL=
NETSHIELD_ALERT_EMAIL_FROM=

# ---------------------------------------------------------------------------
# Notifications - Slack / generic webhook (optional)
# ---------------------------------------------------------------------------
NETSHIELD_SLACK_WEBHOOK_URL=
NETSHIELD_WEBHOOK_URL=
NETSHIELD_WEBHOOK_TIMEOUT=5

# ---------------------------------------------------------------------------
# Threat intelligence (optional)
# ---------------------------------------------------------------------------
# local = answer from the local indicator table only (default, always works)
# http  = generic HTTP provider; requires BASE_URL and API_KEY below
THREAT_INTEL_PROVIDER=local
THREAT_INTEL_API_KEY=
THREAT_INTEL_BASE_URL=
THREAT_INTEL_TIMEOUT=5

# ---------------------------------------------------------------------------
# Live packet capture (optional; requires Scapy, and Npcap on Windows)
# ---------------------------------------------------------------------------
NETSHIELD_CAPTURE_ENABLED=false
NETSHIELD_CAPTURE_INTERFACE=
NETSHIELD_CAPTURE_BPF_FILTER=

# ---------------------------------------------------------------------------
# Zeek integration (optional)
# ---------------------------------------------------------------------------
# Directory containing conn.log
NETSHIELD_ZEEK_LOG_DIR=

# ---------------------------------------------------------------------------
# Streaming
# ---------------------------------------------------------------------------
NETSHIELD_STREAM_MAX_EVENTS=200
NETSHIELD_REPLAY_INTERVAL_SECONDS=2.0

# ---------------------------------------------------------------------------
# Frontend build-time settings (frontend/.env)
# ---------------------------------------------------------------------------
# Leave empty to use the Vite dev proxy / same-origin deployment.
# VITE_API_BASE=http://127.0.0.1:8000
#
# Where the Vite dev server proxies /api and /health. Put this in
# frontend/.env (not the root .env). Set it when the backend runs on a
# non-default port.
# VITE_PROXY_TARGET=http://127.0.0.1:8001
