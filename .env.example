# Copy to .env locally. Never commit .env or share its contents.
# Free Cloudflare Turnstile widget keys; configure its hostname allowlist.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Exact expected hostname from Siteverify, e.g. 127.0.0.1 (no scheme/port).
TURNSTILE_HOSTNAME=127.0.0.1
# Generate a random invitation; distribute only to authorised people.
REGISTRATION_CODE=
# Optional comma-separated permitted email addresses for a private internship demo.
AUTHORIZED_EMAILS=
# Gmail example: enable Google 2-Step Verification and create an app password.
# Use an eligible account; app passwords may be unavailable on some managed accounts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
