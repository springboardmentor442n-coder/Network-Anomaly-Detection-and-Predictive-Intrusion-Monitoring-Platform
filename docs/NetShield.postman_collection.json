    {
      "name": "Printable scan report",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/scans/{{scan_id}}/report-html"
      }
    },
    {
      "name": "Delete completed scan results",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/scans/{{scan_id}}"
      }
    },
    {
      "name": "Investigation add-ons",
      "item": [
        {
          "name": "Saved overview",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/overview"
          }
        },
        {
          "name": "Incident case",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/incidents/{{incident_id}}/case"
          }
        },
        {
          "name": "Local TreeSHAP",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/incidents/{{incident_id}}/explanation"
          }
        },
        {
          "name": "Download case PDF",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/incidents/{{incident_id}}/case.pdf"
          }
        },
