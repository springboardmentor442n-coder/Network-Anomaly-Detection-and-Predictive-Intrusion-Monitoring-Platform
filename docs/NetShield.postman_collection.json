{
  "info": {
    "name": "TraceVigil AI - Verified accounts and investigations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "email",
      "value": "YOUR_VERIFIED_EMAIL"
    },
    {
      "key": "password",
      "value": "YOUR_PASSWORD"
    },
    {
      "key": "source",
      "value": "cicids_demo_real_ips.csv"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "scan_id",
      "value": ""
    },
    {
      "key": "incident_id",
      "value": ""
    },
    {
      "key": "incident_id",
      "value": "1"
    },
    {
      "key": "captcha_token",
      "value": "FRESH_REAL_TURNSTILE_TOKEN"
    },
    {
      "key": "challenge_id",
      "value": ""
    },
    {
      "key": "email_code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/signup",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"YOUR_NEW_USERNAME\", \"display_name\": \"YOUR_NAME\", \"email\": \"{{email}}\", \"password\": \"{{password}}\", \"confirm_password\": \"{{password}}\", \"invitation_code\": \"YOUR_PRIVATE_INVITATION\", \"accept_policy\": true, \"captcha_token\": \"{{captcha_token}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Use the browser enrollment form for invitation, CAPTCHA and email verification. No username-only signup exists."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\", \"captcha_token\": \"{{captcha_token}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.collectionVariables.set(\"token\", pm.response.json().access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/me"
