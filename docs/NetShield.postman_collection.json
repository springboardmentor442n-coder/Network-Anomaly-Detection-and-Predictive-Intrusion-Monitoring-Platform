            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/incidents/{{incident_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Investigating\",\n  \"note\": \"Review source flow and supporting evidence.\"\n}",
          "options": {
