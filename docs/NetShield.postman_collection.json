    {
      "name": "Verify signup email",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/verify",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"challenge_id\": \"{{challenge_id}}\", \"code\": \"{{email_code}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    }
