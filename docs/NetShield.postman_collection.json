          }
        }
      ]
    },
    {
      "name": "Scan report",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/scans/{{scan_id}}/report"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Export rows",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/scans/{{scan_id}}/export"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Stop scan",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/scans/{{scan_id}}/stop"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create polling scan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/scans",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"{{source}}\",\n  \"transport\": \"polling\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.collectionVariables.set(\"scan_id\", pm.response.json().scan_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Poll results",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/scans/{{scan_id}}/poll"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Scan history",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/scans"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List incidents",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/incidents"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Update incident",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/incidents/{{incident_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Investigating\",\n  \"note\": \"Review source flow and supporting evidence.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Team (Admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/team"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Audit (Admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/audit"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Successful response\", function () { pm.expect(pm.response.code).to.be.within(200, 299); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Printable scan report",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/scans/{{scan_id}}/report-html"
      }
    },
    {
      "name": "Delete completed scan results",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/scans/{{scan_id}}"
      }
    },
    {
      "name": "Investigation add-ons",
      "item": [
        {
          "name": "Saved overview",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/overview"
          }
        },
        {
          "name": "Incident case",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/incidents/{{incident_id}}/case"
          }
        },
        {
          "name": "Local TreeSHAP",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/incidents/{{incident_id}}/explanation"
          }
        },
        {
          "name": "Download case PDF",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/incidents/{{incident_id}}/case.pdf"
          }
        },
        {
          "name": "Download incident XLSX",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/incidents-export.xlsx"
          }
        }
      ]
    },
    {
      "name": "Verify signup email",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/auth/verify",
        "auth": {
          "type": "noauth"
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"challenge_id\": \"{{challenge_id}}\", \"code\": \"{{email_code}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Security events and IP investigation",
      "item": [
        {
          "name": "List permitted security events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/security/events?limit=50"
          }
        },
        {
          "name": "Filter authentication failures",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/security/events?action=login_rejected&outcome=Denied"
          }
        },
        {
          "name": "Export filtered security events NDJSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/security/events/export"
          }
        },
        {
          "name": "Investigate IP in permitted saved scans",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/security/ip?ip={{ip_address}}"
          }
        },
        {
          "name": "Investigate IP in selected scan",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/security/ip?ip={{ip_address}}&scan_id={{scan_id}}"
          }
        },
        {
          "name": "Export IP evidence JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/security/ip/export?ip={{ip_address}}"
          }
        },
        {
          "name": "Save my IP investigation note",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/security/ip/case",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ip\": \"{{ip_address}}\",\n  \"status\": \"Investigating\",\n  \"note\": \"Reviewing saved flow and endpoint evidence.\",\n  \"version\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Sign out and revoke current token",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}/api/logout"
          }
        }
      ]
    }
  ]
}
